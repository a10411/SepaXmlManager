@page "/contacts"
@using System.Net.Http.Json
@using System.Net.Http.Headers
@using SepaXmlManager.Models.Entities
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Contactos - SEPA XML Manager</PageTitle>

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Gestão de Contactos (Clientes e Fornecedores)</h2>
            <small class="text-muted">Registo, validação de IBAN/NIF e gestão de mandatos de débito direto</small>
        </div>
        <button class="btn btn-primary btn-sm" @onclick="OpenNewContactForm">
            + Novo Contacto
        </button>
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
            @statusMessage
            <button type="button" class="btn-close" @onclick="() => statusMessage = string.Empty"></button>
        </div>
    }

    @if (showForm)
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0">@(isEditing ? $"Editar Contacto #{currentContact.Id}" : "Registar Novo Contacto")</h5>
                <button type="button" class="btn-close btn-close-white" @onclick="CancelForm"></button>
            </div>
            <div class="card-body">
                <EditForm Model="currentContact" OnValidSubmit="SaveContactAsync">
                    <DataAnnotationsValidator />

                    <div class="row g-3">
                        <div class="col-md-5">
                            <label class="form-label fw-bold">Nome / Designação Social</label>
                            <InputText class="form-control" @bind-Value="currentContact.Name" placeholder="Ex: Ana Martins" required />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-bold">NIF</label>
                            <InputText class="form-control" @bind-Value="currentContact.NIF" placeholder="Ex: 214567893" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold">BIC / SWIFT</label>
                            <InputText class="form-control" @bind-Value="currentContact.BIC" placeholder="Ex: CGDIPTPL" maxlength="11" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">IBAN</label>
                            <InputText class="form-control" @bind-Value="currentContact.IBAN" placeholder="PT50..." maxlength="34" required />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-bold">Ref. Mandato (PAIN.008)</label>
                            <InputText class="form-control" @bind-Value="currentContact.MandateReference" placeholder="Ex: MND-2026-001" maxlength="35" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-bold">Data Assinatura Mandato</label>
                            <InputDate class="form-control" @bind-Value="currentContact.DateSignatureMandate" />
                        </div>

                        <div class="col-md-12 d-flex justify-content-between align-items-center mt-3">
                            <div class="form-check form-switch">
                                <InputCheckbox class="form-check-input" id="activeSwitch" @bind-Value="currentContact.IsActive" />
                                <label class="form-check-label fw-semibold" for="activeSwitch">Contacto Ativo</label>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-outline-secondary" @onclick="CancelForm">
                                    Cancelar
                                </button>
                                <button type="submit" class="btn btn-primary" disabled="@isSaving">
                                    @(isSaving ? "A guardar..." : "Guardar Alterações")
                                </button>
                            </div>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <div class="row g-2 align-items-center justify-content-between">
                <div class="col-md-3">
                    <h5 class="mb-0 fw-bold">Lista de Contactos</h5>
                </div>
                <div class="col-md-9 d-flex gap-2 justify-content-md-end">
                    <input type="text" class="form-control form-control-sm w-50"
                           placeholder="Pesquisar por Nome, NIF, IBAN ou Mandato..."
                           @bind="searchTerm" @bind:event="oninput" />

                    <select class="form-select form-select-sm w-auto" @bind="statusFilter">
                        <option value="TODOS">Todos os Estados</option>
                        <option value="ATIVOS">Apenas Ativos</option>
                        <option value="INATIVOS">Apenas Inativos</option>
                    </select>

                    <button class="btn btn-primary btn-sm" @onclick="LoadContactsAsync">
                        Atualizar Lista
                    </button>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            @if (isLoading)
            {
                <div class="p-4 text-center text-muted">A carregar contactos...</div>
            }
            else if (FilteredContacts.Any())
            {
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Nome</th>
                            <th>NIF</th>
                            <th>IBAN</th>
                            <th>BIC</th>
                            <th>Mandato (PAIN.008)</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var contact in FilteredContacts)
                        {
                            <tr>
                                <td class="fw-semibold">@contact.Name</td>
                                <td>@contact.NIF</td>
                                <td><code>@contact.IBAN</code></td>
                                <td>@(string.IsNullOrWhiteSpace(contact.BIC) ? "-" : contact.BIC)</td>
                                <td>@(string.IsNullOrWhiteSpace(contact.MandateReference) ? "-" : contact.MandateReference)</td>
                                <td class="text-center">
                                    @if (contact.IsActive)
                                    {
                                        <span class="badge bg-success">Ativo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inativo</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-primary me-1" @onclick="() => EditContact(contact)">
                                        Editar
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteContactAsync(contact.Id)">
                                        Remover
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="p-4 text-center text-muted">
                    Nenhum contacto encontrado para os critérios de pesquisa selecionados.
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<Contact> contacts = new();
    private Contact currentContact = new();
    private string searchTerm = string.Empty;
    private string statusFilter = "TODOS";
    private bool showForm = false;
    private bool isEditing = false;
    private bool isLoading = true;
    private bool isSaving = false;
    private bool isError = false;
    private string statusMessage = string.Empty;

    // Filtra dinamicamente os contactos por texto e estado de ativação.
    private IEnumerable<Contact> FilteredContacts => contacts
        .Where(c =>
            (statusFilter == "TODOS" ||
             (statusFilter == "ATIVOS" && c.IsActive) ||
             (statusFilter == "INATIVOS" && !c.IsActive)) &&
            (string.IsNullOrWhiteSpace(searchTerm) ||
             (c.Name?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
             (c.NIF?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
             (c.IBAN?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
             (c.MandateReference?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)))
        .OrderBy(c => c.Name);

    protected override async Task OnInitializedAsync()
    {
        await LoadContactsAsync();
    }

    // Configura o cabeçalho de autorização com o token JWT armazenado localmente.
    private async Task<bool> EnsureAuthenticatedAsync()
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");

        if (string.IsNullOrEmpty(token))
        {
            Navigation.NavigateTo("/login");
            return false;
        }

        Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        return true;
    }

    // Obtém a lista de contactos registados na API.
    private async Task LoadContactsAsync()
    {
        isLoading = true;

        try
        {
            if (!await EnsureAuthenticatedAsync()) return;

            var response = await Http.GetAsync("api/Contact");

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<List<Contact>>();
                contacts = result ?? new List<Contact>();
            }
            else
            {
                isError = true;
                statusMessage = "Não foi possível carregar a lista de contactos.";
            }
        }
        catch (Exception ex)
        {
            isError = true;
            statusMessage = $"Erro de comunicação com a API: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    // Inicializa o formulário em modo de criação.
    private void OpenNewContactForm()
    {
        currentContact = new Contact
        {
            IsActive = true,
            CountryCode = "PT",
            BIC = "XXXPTPL0",
            DateSignatureMandate = DateTime.Today
        };
        isEditing = false;
        showForm = true;
        statusMessage = string.Empty;
    }

    // Clona os dados do contacto selecionado para edição no formulário.
    private void EditContact(Contact contact)
    {
        currentContact = new Contact
        {
            Id = contact.Id,
            CompanyId = contact.CompanyId,
            Name = contact.Name,
            NIF = contact.NIF,
            IBAN = contact.IBAN,
            BIC = contact.BIC,
            CountryCode = contact.CountryCode,
            MandateReference = contact.MandateReference,
            DateSignatureMandate = contact.DateSignatureMandate,
            IsActive = contact.IsActive
        };
        isEditing = true;
        showForm = true;
        statusMessage = string.Empty;
    }

    private void CancelForm()
    {
        showForm = false;
        currentContact = new();
    }

    // Submete a criação (POST) ou atualização (PUT) do contacto na API.
    private async Task SaveContactAsync()
    {
        isSaving = true;
        statusMessage = string.Empty;
        isError = false;

        try
        {
            if (!await EnsureAuthenticatedAsync()) return;

            currentContact.IBAN = currentContact.IBAN?.Replace(" ", "").ToUpper() ?? string.Empty;
            currentContact.NIF = currentContact.NIF?.Replace(" ", "") ?? string.Empty;

            HttpResponseMessage response;

            if (isEditing)
            {
                response = await Http.PutAsJsonAsync($"api/Contact/{currentContact.Id}", currentContact);
            }
            else
            {
                response = await Http.PostAsJsonAsync("api/Contact", currentContact);
            }

            if (response.IsSuccessStatusCode)
            {
                isError = false;
                statusMessage = isEditing
                    ? "Contacto atualizado com sucesso."
                    : "Novo contacto registado com sucesso.";
                showForm = false;
                await LoadContactsAsync();
            }
            else
            {
                isError = true;
                var errorBody = await response.Content.ReadAsStringAsync();
                statusMessage = $"Erro de validação: {errorBody}";
            }
        }
        catch (Exception ex)
        {
            isError = true;
            statusMessage = $"Erro ao guardar contacto: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    // Solicita a remoção do contacto através do endpoint DELETE.
    private async Task DeleteContactAsync(int id)
    {
        statusMessage = string.Empty;
        isError = false;

        try
        {
            if (!await EnsureAuthenticatedAsync()) return;

            var response = await Http.DeleteAsync($"api/Contact/{id}");

            if (response.IsSuccessStatusCode)
            {
                isError = false;
                statusMessage = "Contacto removido com sucesso.";
                await LoadContactsAsync();
            }
            else
            {
                isError = true;
                var errorBody = await response.Content.ReadAsStringAsync();
                statusMessage = $"Não foi possível remover o contacto: {errorBody}";
            }
        }
        catch (Exception ex)
        {
            isError = true;
            statusMessage = $"Erro ao remover contacto: {ex.Message}";
        }
    }
}