@page "/batches"
@using System.Net.Http.Json
@using System.Net.Http.Headers
@using SepaXmlManager.Models.Entities
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Lotes SEPA - SEPA XML Manager</PageTitle>

<div class="container-fluid mt-3">
    <div class="mb-4">
        <h2 class="fw-bold mb-0">Gestão de Lotes SEPA</h2>
        <small class="text-muted">Importação massiva de transações via CSV e geração de ficheiros ISO 20022</small>
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
            @statusMessage
            <button type="button" class="btn-close" @onclick="() => statusMessage = string.Empty"></button>
        </div>
    }

    <!-- Secção de Importação de Ficheiro CSV -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-dark text-white py-3">
            <h5 class="mb-0">Importar Novo Lote (CSV)</h5>
        </div>
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Tipo de Operação SEPA</label>
                    <select class="form-select" @bind="selectedOperationType">
                        <option value="PAGAMENTO">Pagamentos / Transferências (PAIN.001)</option>
                        <option value="COBRANCA">Cobranças / Débitos Diretos (PAIN.008)</option>
                    </select>
                </div>

                <div class="col-md-5">
                    <label class="form-label fw-bold">Ficheiro CSV (Delimitador: ponto e vírgula)</label>
                    <InputFile OnChange="HandleFileSelected" class="form-control" accept=".csv" />
                </div>

                <div class="col-md-3">
                    <button class="btn btn-primary w-100" @onclick="UploadCsvAsync" disabled="@(selectedFile == null || isUploading)">
                        @if (isUploading)
                        {
                            <span>A processar...</span>
                        }
                        else
                        {
                            <span>Importar e Gerar Lote</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabela de Lotes Registados -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <div class="row g-2 align-items-center justify-content-between">
                <div class="col-md-4">
                    <h5 class="mb-0 fw-bold">Histórico de Lotes Gerados</h5>
                </div>
                <div class="col-md-8 d-flex gap-2 justify-content-md-end">
                    <input type="text" class="form-control form-control-sm w-50"
                           placeholder="Pesquisar por ID, MsgId ou Data (dd/MM/yyyy)..."
                           @bind="batchSearchTerm" @bind:event="oninput" />

                    <select class="form-select form-select-sm w-auto" @bind="batchTypeFilter">
                        <option value="TODOS">Todos os Tipos</option>
                        <option value="PAIN.001">Pagamentos (PAIN.001)</option>
                        <option value="PAIN.008">Cobranças (PAIN.008)</option>
                    </select>

                    <button class="btn btn-primary btn-sm" @onclick="LoadBatchesAsync">
                        Atualizar Lista
                    </button>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            @if (isLoading)
            {
                <div class="p-4 text-center text-muted">A carregar lotes...</div>
            }
            else if (FilteredBatches.Any())
            {
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Identificador (MsgId)</th>
                            <th>Data de Criação</th>
                            <th>Norma / Tipo</th>
                            <th class="text-center">N.º Transações</th>
                            <th class="text-end">Montante Total</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var batch in FilteredBatches)
                        {
                            <tr>
                                <td class="fw-bold">#@batch.Id</td>
                                <td><code>@batch.MsgId</code></td>
                                <td>@batch.DateCreation.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if (batch.TypeOperation == "PAIN.008" || batch.TypeOperation == "COBRANCA")
                                    {
                                        <span class="badge bg-success">PAIN.008 (Cobrança)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">PAIN.001 (Pagamento)</span>
                                    }
                                </td>
                                <td class="text-center">@batch.TotalTransactions</td>
                                <td class="text-end fw-bold">@batch.TotalAmount.ToString("N2") €</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-primary" @onclick="() => DownloadXmlAsync(batch)" disabled="@(downloadingBatchId == batch.Id)">
                                        @if (downloadingBatchId == batch.Id)
                                        {
                                            <span>A gerar XML...</span>
                                        }
                                        else
                                        {
                                            <span>Descarregar XML</span>
                                        }
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="p-4 text-center text-muted">
                    Nenhum lote encontrado para os critérios de pesquisa selecionados.
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<TransferBatch> batches = new();
    private IBrowserFile? selectedFile;
    private string selectedOperationType = "PAGAMENTO";
    private string batchSearchTerm = string.Empty;
    private string batchTypeFilter = "TODOS";
    private string statusMessage = string.Empty;
    private bool isError = false;
    private bool isLoading = true;
    private bool isUploading = false;
    private int? downloadingBatchId = null;

    // Filtra a lista de lotes por identificador de mensagem, data ou tipo de norma SEPA.
    private IEnumerable<TransferBatch> FilteredBatches => batches
        .Where(b =>
            (batchTypeFilter == "TODOS" ||
             (batchTypeFilter == "PAIN.008" && (b.TypeOperation == "PAIN.008" || b.TypeOperation == "COBRANCA")) ||
             (batchTypeFilter == "PAIN.001" && (b.TypeOperation == "PAIN.001" || b.TypeOperation == "PAGAMENTO"))) &&
            (string.IsNullOrWhiteSpace(batchSearchTerm) ||
             (b.MsgId?.Contains(batchSearchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
             b.DateCreation.ToString("dd/MM/yyyy").Contains(batchSearchTerm, StringComparison.OrdinalIgnoreCase) ||
             b.Id.ToString().Contains(batchSearchTerm)))
        .OrderByDescending(b => b.DateCreation);

    // Inicializa o componente e carrega a listagem de lotes existentes.
    protected override async Task OnInitializedAsync()
    {
        await LoadBatchesAsync();
    }

    // Configura o cabeçalho de autorização com o token JWT armazenado localmente.
    private async Task<bool> EnsureAuthenticatedAsync()
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");

        if (string.IsNullOrEmpty(token))
        {
            Navigation.NavigateTo("/login");
            return false;
        }

        Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        return true;
    }

    // Obtém a lista de lotes a partir da API.
    private async Task LoadBatchesAsync()
    {
        isLoading = true;

        try
        {
            if (!await EnsureAuthenticatedAsync()) return;

            var response = await Http.GetAsync("api/Batch");

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<List<TransferBatch>>();
                batches = result ?? new List<TransferBatch>();
            }
            else
            {
                isError = true;
                statusMessage = "Não foi possível obter a lista de lotes.";
            }
        }
        catch (Exception ex)
        {
            isError = true;
            statusMessage = $"Erro de comunicação com a API: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    // Regista o ficheiro CSV selecionado pelo utilizador no formulário.
    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        statusMessage = string.Empty;
    }

    // Envia o ficheiro CSV via MultipartFormDataContent para processamento na API.
    private async Task UploadCsvAsync()
    {
        if (selectedFile == null) return;

        isUploading = true;
        statusMessage = string.Empty;
        isError = false;

        try
        {
            if (!await EnsureAuthenticatedAsync()) return;

            using var content = new MultipartFormDataContent();
            var fileStream = selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // Limite de 10 MB
            var streamContent = new StreamContent(fileStream);
            streamContent.Headers.ContentType = new MediaTypeHeaderValue("text/csv");

            // O nome do parâmetro "file" corresponde ao argumento IFormFile esperado no SepaController.
            content.Add(streamContent, "file", selectedFile.Name);

            var response = await Http.PostAsync($"api/Sepa/upload-batch?operationType={selectedOperationType}", content);

            if (response.IsSuccessStatusCode)
            {
                isError = false;
                statusMessage = "Ficheiro CSV importado e lote gerado com sucesso.";
                selectedFile = null;
                await LoadBatchesAsync();
            }
            else
            {
                isError = true;
                var errorBody = await response.Content.ReadAsStringAsync();
                statusMessage = $"Falha no processamento do ficheiro: {errorBody}";
            }
        }
        catch (Exception ex)
        {
            isError = true;
            statusMessage = $"Erro ao enviar o ficheiro: {ex.Message}";
        }
        finally
        {
            isUploading = false;
        }
    }

    // Requisita a geração e validação XSD do ficheiro XML e inicia a transferência no navegador.
    private async Task DownloadXmlAsync(TransferBatch batch)
    {
        downloadingBatchId = batch.Id;
        statusMessage = string.Empty;
        isError = false;

        try
        {
            if (!await EnsureAuthenticatedAsync()) return;

            bool isCollection = batch.TypeOperation == "PAIN.008" || batch.TypeOperation == "COBRANCA";
            string endpoint = isCollection
                ? $"api/Sepa/download-pain008/{batch.Id}"
                : $"api/Sepa/download-pain001/{batch.Id}";

            var response = await Http.GetAsync(endpoint);

            if (response.IsSuccessStatusCode)
            {
                var xmlBytes = await response.Content.ReadAsByteArrayAsync();
                var base64Data = Convert.ToBase64String(xmlBytes);
                string prefix = isCollection ? "PAIN008_Cobrancas" : "PAIN001_Pagamentos";
                string fileName = $"SEPA_{prefix}_Lote_{batch.Id}_{DateTime.Now:yyyyMMddHHmmss}.xml";

                await JS.InvokeVoidAsync("downloadFileFromBase64", fileName, "application/xml", base64Data);
            }
            else
            {
                isError = true;
                var errorBody = await response.Content.ReadAsStringAsync();
                statusMessage = $"Erro na geração ou validação do ficheiro XML: {errorBody}";
            }
        }
        catch (Exception ex)
        {
            isError = true;
            statusMessage = $"Erro ao descarregar o ficheiro XML: {ex.Message}";
        }
        finally
        {
            downloadingBatchId = null;
        }
    }
}