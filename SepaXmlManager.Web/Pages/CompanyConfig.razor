@page "/company"
@using System.Net.Http.Json
@using System.Net.Http.Headers
@using System.Net
@using SepaXmlManager.Models.Entities
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Administração e Empresa - SEPA XML Manager</PageTitle>

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Configuração da Empresa e Acessos</h2>
            <small class="text-muted">Dados bancários da entidade emissora (ISO 20022) e registo interno de operadores</small>
        </div>
        <button class="btn btn-primary btn-sm" @onclick="LoadCompanyAsync" disabled="@isLoading">
            Recarregar Dados
        </button>
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
            @statusMessage
            <button type="button" class="btn-close" @onclick="() => statusMessage = string.Empty"></button>
        </div>
    }

    <div class="row">
        <!-- Coluna Esquerda: Configuração da Empresa -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="mb-0">Dados da Entidade Ordenante / Credora</h5>
                </div>
                <div class="card-body p-4">
                    @if (isLoading)
                    {
                        <div class="p-4 text-center text-muted">A carregar dados da empresa...</div>
                    }
                    else
                    {
                        <EditForm Model="companyModel" OnValidSubmit="SaveCompanyAsync">
                            <DataAnnotationsValidator />

                            <div class="row g-3">
                                <div class="col-md-8">
                                    <label class="form-label fw-bold">Nome / Designação Social</label>
                                    <InputText class="form-control" @bind-Value="companyModel.Name" placeholder="Ex: Minha Empresa Lda" maxlength="100" required />
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label fw-bold">NIF / NIPC</label>
                                    <InputText class="form-control" @bind-Value="companyModel.NIF" placeholder="Ex: 509123456" maxlength="20" required />
                                </div>

                                <div class="col-md-8">
                                    <label class="form-label fw-bold">IBAN da Conta Principal</label>
                                    <InputText class="form-control" @bind-Value="companyModel.IBAN" placeholder="PT50..." maxlength="34" required />
                                    <div class="form-text">Validado matematicamente pelo algoritmo MOD-97-10.</div>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label fw-bold">Código BIC / SWIFT</label>
                                    <InputText class="form-control" @bind-Value="companyModel.BIC" placeholder="Ex: CGDIPTPL" maxlength="11" required />
                                </div>

                                <div class="col-md-12">
                                    <label class="form-label fw-bold">Identificador do Credor SEPA (ICS / IdentityCreditor)</label>
                                    <InputText class="form-control" @bind-Value="companyModel.IdentityCreditor" placeholder="Ex: PT12ZZZ123456" maxlength="35" />
                                    <div class="form-text">Identificador utilizado em operações de Débito Direto SEPA (PAIN.008).</div>
                                </div>

                                <div class="col-md-12 d-flex justify-content-end mt-4">
                                    <button type="submit" class="btn btn-primary px-4 py-2" disabled="@isSaving">
                                        @(isSaving ? "A validar e guardar..." : "Guardar Configuração")
                                    </button>
                                </div>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>

        <!-- Coluna Direita: Gestão Interna de Utilizadores + Resumo -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="mb-0">Registar Novo Operador</h5>
                </div>
                <div class="card-body p-4">
                    @if (!string.IsNullOrEmpty(userStatusMessage))
                    {
                        <div class="alert @(isUserError ? "alert-danger" : "alert-success") alert-dismissible fade show py-2" role="alert">
                            <small>@userStatusMessage</small>
                            <button type="button" class="btn-close" @onclick="() => userStatusMessage = string.Empty"></button>
                        </div>
                    }

                    <EditForm Model="registerModel" OnValidSubmit="RegisterUserAsync">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Nome de Utilizador</label>
                            <InputText class="form-control" @bind-Value="registerModel.Username" placeholder="Ex: contabilidade.01" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Palavra-passe</label>
                            <InputText type="password" class="form-control" @bind-Value="registerModel.Password" placeholder="Mín. 6 caracteres, maiúscula, número e símbolo" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Departamento / Perfil (Role)</label>
                            <InputSelect class="form-select" @bind-Value="registerModel.Role">
                                <option value="Tesouraria">Tesouraria</option>
                                <option value="Contabilidade">Contabilidade</option>
                                <option value="RecursosHumanos">Recursos Humanos</option>
                                <option value="Administrador">Administrador</option>
                            </InputSelect>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2" disabled="@isRegisteringUser">
                            @(isRegisteringUser ? "A criar conta..." : "Criar Conta de Operador")
                        </button>
                    </EditForm>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold">Resumo da Entidade Emissora</h6>
                </div>
                <div class="card-body py-3">
                    <div class="mb-1">
                        <span class="text-muted small">Entidade: </span>
                        <strong>@(string.IsNullOrWhiteSpace(companyModel.Name) ? "Não configurada" : companyModel.Name)</strong>
                    </div>
                    <div class="mb-1">
                        <span class="text-muted small">NIF: </span>
                        <strong>@(string.IsNullOrWhiteSpace(companyModel.NIF) ? "-" : companyModel.NIF)</strong>
                    </div>
                    <div class="mb-1">
                        <span class="text-muted small">IBAN: </span>
                        <code>@(string.IsNullOrWhiteSpace(companyModel.IBAN) ? "-" : companyModel.IBAN)</code>
                    </div>
                    <div class="mb-0">
                        <span class="text-muted small">BIC: </span>
                        <strong>@(string.IsNullOrWhiteSpace(companyModel.BIC) ? "-" : companyModel.BIC)</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private Company companyModel = new();
    private RegisterUserModel registerModel = new();
    private bool isLoading = true;
    private bool isSaving = false;
    private bool isError = false;
    private string statusMessage = string.Empty;

    private bool isRegisteringUser = false;
    private bool isUserError = false;
    private string userStatusMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadCompanyAsync();
    }

    // Configura o cabeçalho de autorização com o token JWT armazenado localmente.
    private async Task<bool> EnsureAuthenticatedAsync()
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");

        if (string.IsNullOrEmpty(token))
        {
            Navigation.NavigateTo("/login");
            return false;
        }

        Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        return true;
    }

    // Obtém os dados da empresa configurada na base de dados através da API.
    private async Task LoadCompanyAsync()
    {
        isLoading = true;
        statusMessage = string.Empty;

        try
        {
            if (!await EnsureAuthenticatedAsync()) return;

            var response = await Http.GetAsync("api/Company");

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<Company>();
                if (result != null)
                {
                    companyModel = result;
                }
            }
            else if (response.StatusCode == HttpStatusCode.NotFound)
            {
                companyModel = new Company { IsActive = true };
                isError = false;
                statusMessage = "Ainda não existe nenhuma empresa configurada. Preencha os dados abaixo para inicializar o sistema.";
            }
            else
            {
                isError = true;
                statusMessage = "Não foi possível carregar os dados da empresa.";
            }
        }
        catch (Exception ex)
        {
            isError = true;
            statusMessage = $"Erro de comunicação com a API: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    // Submete os dados da empresa para o endpoint POST api/Company.
    private async Task SaveCompanyAsync()
    {
        isSaving = true;
        statusMessage = string.Empty;
        isError = false;

        try
        {
            if (!await EnsureAuthenticatedAsync()) return;

            companyModel.IBAN = companyModel.IBAN?.Replace(" ", "").ToUpper() ?? string.Empty;
            companyModel.BIC = companyModel.BIC?.Replace(" ", "").ToUpper() ?? string.Empty;
            companyModel.NIF = companyModel.NIF?.Replace(" ", "") ?? string.Empty;

            var response = await Http.PostAsJsonAsync("api/Company", companyModel);

            if (response.IsSuccessStatusCode)
            {
                var saved = await response.Content.ReadFromJsonAsync<Company>();
                if (saved != null)
                {
                    companyModel = saved;
                }

                isError = false;
                statusMessage = "Configuração da empresa guardada com sucesso.";
            }
            else
            {
                isError = true;
                var errorBody = await response.Content.ReadAsStringAsync();
                statusMessage = $"Erro de validação: {errorBody}";
            }
        }
        catch (Exception ex)
        {
            isError = true;
            statusMessage = $"Erro ao guardar os dados da empresa: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    // Regista um novo operador interno através do endpoint POST api/Auth/register.
    private async Task RegisterUserAsync()
    {
        isRegisteringUser = true;
        userStatusMessage = string.Empty;
        isUserError = false;

        try
        {
            if (!await EnsureAuthenticatedAsync()) return;

            var response = await Http.PostAsJsonAsync("api/Auth/register", registerModel);

            if (response.IsSuccessStatusCode)
            {
                isUserError = false;
                userStatusMessage = $"Operador '{registerModel.Username}' criado com sucesso ({registerModel.Role}).";
                registerModel = new RegisterUserModel();
            }
            else
            {
                isUserError = true;
                var errorBody = await response.Content.ReadAsStringAsync();
                userStatusMessage = $"Falha ao registar operador: {errorBody}";
            }
        }
        catch (Exception ex)
        {
            isUserError = true;
            userStatusMessage = $"Erro ao comunicar com o servidor: {ex.Message}";
        }
        finally
        {
            isRegisteringUser = false;
        }
    }

    public class RegisterUserModel
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string Role { get; set; } = "Tesouraria";
    }
}