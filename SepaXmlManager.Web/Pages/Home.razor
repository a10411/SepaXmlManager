@page "/"
@using System.Net.Http.Json
@using System.Net.Http.Headers
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Dashboard - SEPA XML Manager</PageTitle>

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Painel de Controlo Financeiro</h2>
            <small class="text-muted">Resumo de operações SEPA (ISO 20022)</small>
        </div>
        <button class="btn btn-outline-secondary btn-sm" @onclick="LoadDashboardAsync">
            Atualizar Dados
        </button>
    </div>

    @if (isLoading)
    {
        <div class="alert alert-info">A carregar métricas financeiras...</div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-warning">
            @errorMessage
            <div class="mt-2">
                <a href="login" class="btn btn-primary btn-sm">Ir para Autenticação</a>
            </div>
        </div>
    }
    else if (dashboardData != null)
    {
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card shadow-lg border-0 border-start border-success border-4 h-100">
                    <div class="card-body">
                        <h6 class="text-muted text-uppercase mb-2">Total Cobranças (PAIN.008)</h6>
                        <h3 class="fw-bold text-success mb-0">@dashboardData.Overview.TotalVolumeCollections.ToString("N2") €</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-lg border-0 border-start border-danger border-4 h-100">
                    <div class="card-body">
                        <h6 class="text-muted text-uppercase mb-2">Total Pagamentos (PAIN.001)</h6>
                        <h3 class="fw-bold text-danger mb-0">@dashboardData.Overview.TotalVolumePayments.ToString("N2") €</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-lg border-0 border-start border-primary border-4 h-100">
                    <div class="card-body">
                        <h6 class="text-muted text-uppercase mb-2">Saldo Líquido</h6>
                        <h3 class="fw-bold text-primary mb-0">@dashboardData.Overview.NetBalance.ToString("N2") €</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-lg border-0 border-start border-dark border-4 h-100">
                    <div class="card-body">
                        <h6 class="text-muted text-uppercase mb-2">Lotes / Contactos Ativos</h6>
                        <h3 class="fw-bold text-dark mb-0">@dashboardData.Overview.TotalBatchesGenerated <small class="text-muted fs-6">lotes</small> / @dashboardData.Overview.TotalContacts <small class="text-muted fs-6">contactos</small></h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-lg border-0">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold ms-n4">Top 5 - Maior Volume de Cobrança</h5>
            </div>
            <div class="card-body p-0">
                @if (dashboardData.TopClients.Any())
                {
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Nome do Cliente</th>
                                <th>NIF</th>
                                <th class="text-end">Total Cobrado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var client in dashboardData.TopClients)
                            {
                                <tr>
                                    <td class="fw-semibold">@client.ClientName</td>
                                    <td>@client.TaxId</td>
                                    <td class="text-end fw-bold text-success">@client.TotalCharged.ToString("N2") €</td>
                                </tr>
                            }  
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="p-4 text-center text-muted">
                        Não existem registos de cobrança processados para apresentar.
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private DashboardResponseDto? dashboardData;
    private bool isLoading = true;
    private string errorMessage = string.Empty;

    // Inicializa o componente e desencadeia o carregamento dos indicadores financeiros.
    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
    }

    // Obtém o token armazenado localmente e requisita os dados estatísticos à API.
    private async Task LoadDashboardAsync()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");

            if (string.IsNullOrEmpty(token))
            {
                Navigation.NavigateTo("/login");
                return;
            }

            // Garante que o cabeçalho de autorização contém o token JWT mesmo após atualização da página (F5).
            Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

            var response = await Http.GetAsync("api/Stats/dashboard");

            if (response.IsSuccessStatusCode)
            {
                dashboardData = await response.Content.ReadFromJsonAsync<DashboardResponseDto>();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                errorMessage = "A sessão expirou ou o utilizador não se encontra autenticado.";
            }
            else
            {
                errorMessage = "Não foi possível carregar os indicadores do painel de controlo.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro de ligação à API: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    // Estruturas de transferência para deserialização da resposta do endpoint de estatísticas.
    public class DashboardResponseDto
    {
        public OverviewDto Overview { get; set; } = new();
        public List<TopClientDto> TopClients { get; set; } = new();
    }

    public class OverviewDto
    {
        public int TotalContacts { get; set; }
        public int TotalBatchesGenerated { get; set; }
        public decimal TotalVolumePayments { get; set; }
        public decimal TotalVolumeCollections { get; set; }
        public decimal NetBalance { get; set; }
    }

    public class TopClientDto
    {
        public string ClientName { get; set; } = string.Empty;
        public string TaxId { get; set; } = string.Empty;
        public decimal TotalCharged { get; set; }
    }
}